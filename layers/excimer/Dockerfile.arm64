# ARM64 only: official PHP image (fast build). Layout matches Bref so COPY --from= works.
ARG PHP_VERSION
ENV PHP_TAG="${PHP_VERSION:0:1}.${PHP_VERSION:1:1}"
FROM php:${PHP_TAG}-cli AS ext

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN pecl install excimer \
    && cp "$(php-config --extension-dir)/excimer.so" /tmp/excimer.so \
    && echo 'extension=excimer.so' > /tmp/ext.ini

FROM scratch
COPY --from=ext /tmp/excimer.so /opt/bref/extensions/excimer.so
COPY --from=ext /tmp/ext.ini /opt/bref/etc/php/conf.d/ext-excimer.ini
